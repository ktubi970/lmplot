PACKAGE chromote 0.5.1 
PACKAGE shinytest2 0.5.1 

CHROMOTE FUNCTION launch_chrome 
function (path = find_chrome(), args = get_chrome_args()) 
{
    if (is.null(path)) {
        stop("Invalid path to Chrome")
    }
    res <- with_random_port(launch_chrome_impl, path = path, 
        args = args)
    res
}
