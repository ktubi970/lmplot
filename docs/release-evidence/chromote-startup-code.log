FUNCTION app_stop 
function (self, private, signal_timeout = missing_arg()) 
{
    "!DEBUG AppDriver$stop"
    ckm8_assert_app_driver(self, private)
    signal_timeout <- resolve_signal_timeout(signal_timeout)
    if (private$state == "stopped") {
        return(invisible(private$shiny_proc_value))
    }
    self$log_message("Closing chromote session")
    tryCatch(self$get_chromote_session()$close(), error = function(e) {
        self$log_message(paste0("Error closing chromote session!\n", 
            conditionMessage(e)))
    })
    if (!is.null(private$shiny_process)) {
        if (private$shiny_process$is_alive()) {
            self$log_message("Ending Shiny process. Ignoring Shiny process result")
            tryCatch({
                private$shiny_process$interrupt()
                private$shiny_process$wait(signal_timeout)
                private$shiny_process$signal(tools::SIGTERM)
                private$shiny_process$wait(signal_timeout)
                private$shiny_process$kill()
            }, error = function(e) {
                self$log_message(paste0("Error closing Shiny process!\n", 
                  conditionMessage(e)))
            })
        }
        else {
            self$log_message("Getting Shiny process result")
            tryCatch(private$shiny_proc_value <- private$shiny_process$get_result(), 
                error = function(e) {
                  self$log_message(paste0("Error getting Shiny process result!\n", 
                    conditionMessage(e)))
                })
        }
    }
    private$state <- "stopped"
    invisible(private$shiny_proc_value)
}
