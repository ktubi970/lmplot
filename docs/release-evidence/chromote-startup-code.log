FUNCTION chromote_wait_for_condition 
function (chromote_session, condition_js, ..., timeout = 15 * 
    1000, interval = 100) 
{
    rlang::check_dots_empty()
    condition_js <- as.character(condition_js)
    checkmate::assert_character(condition_js, any.missing = FALSE, 
        len = 1)
    checkmate::assert_number(timeout, lower = 0)
    checkmate::assert_number(interval, lower = 0)
    escaped_condition_js <- paste0(deparse(condition_js, width.cutoff = 500L), 
        collapse = " ")
    script <- paste0("new Promise((resolve, reject) => {\n  let start = Date.now();\n  const condition = () => {\n    return eval(", 
        escaped_condition_js, ");\n  };\n", "chromote_wait_for_condition = () => {\n    let diffTime = new Date() - (+start + ", 
        timeout, ");\n    if (diffTime > 0) {\n      return reject('Timed out waiting for JavaScript script to return `true`');\n    }\n    try {\n      if (condition()) {\n        return resolve();\n      }\n    } catch (e) {\n      reject(e);\n    }\n    setTimeout(chromote_wait_for_condition, ", 
        interval, ");\n  }\n  chromote_wait_for_condition();\n});")
    ret <- chromote_eval(chromote_session, script, timeout = timeout * 
        2)
    if (length(ret$exceptionDetails) > 0) {
        exception <- ret$exceptionDetails$exception
        if (exception$type == "string" && length(exception$value) == 
            1 && isTRUE(grepl("Timed out waiting for JavaScript script", 
            exception$value, fixed = TRUE))) {
            rlang::abort(c("Timed out waiting for JavaScript script to return `true`", 
                i = paste0("`timeout`: ", timeout), i = paste0("`script`:\n", 
                  condition_js)))
        }
        rlang::abort(c("Error found while waiting for JavaScript script to return `true`.", 
            i = paste0("`script`:\n", condition_js), i = paste0("Error:\n", 
                obj_to_string(exception))))
    }
    invisible(chromote_session)
}
