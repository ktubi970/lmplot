FUNCTION app_click 
function (self, private, input = missing_arg(), output = missing_arg(), 
    selector = missing_arg(), ...) 
{
    ckm8_assert_app_driver(self, private)
    node_id <- app_find_node_id(self, private, input = input, 
        output = output, selector = selector)
    if (!rlang::is_missing(input)) {
        self$set_inputs(`:=`(!!input, "click"), ...)
    }
    else {
        rlang::check_dots_empty()
        self$log_message(paste0("Clicking HTML element with selector: ", 
            node_id_css_selector(self, private, input = input, 
                output = output, selector = selector)))
        click_script <- "\n      function() {\n        this.click()\n      }\n    "
        chromote_call_js_on_node(self$get_chromote_session(), 
            node_id, click_script)
    }
    invisible(self)
}
