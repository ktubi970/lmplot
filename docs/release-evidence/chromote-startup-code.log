FUNCTION app_download 
function (self, private, output, name = NULL, save_dir = tempdir(), 
    use_counter = FALSE) 
{
    ckm8_assert_app_driver(self, private)
    self$log_message(paste0("Downloading file for output id: ", 
        output))
    sub_url <- chromote_eval(self$get_chromote_session(), paste0("$('#", 
        output, "').attr('href')"))$result$value
    if (identical(sub_url, "")) {
        app_abort(self, private, paste0("Download from '#", output, 
            "' failed"))
    }
    full_url <- paste0(private$shiny_url$get(), sub_url)
    req <- app_httr2_get(self, private, full_url)
    content_dispo <- httr2::resp_headers(req)[["content-disposition"]]
    filename_header <- NULL
    if (length(content_dispo) == 1 && is.character(content_dispo) && 
        nzchar(content_dispo)) {
        vals <- strsplit(content_dispo, "filename=")[[1]]
        if (length(vals) > 1) {
            filename_header <- gsub("\"", "", vals[2], fixed = TRUE)
            self$log_message(paste0("Content disposition file name: ", 
                filename_header))
        }
    }
    include_dash <- TRUE
    filename <- if (!is.null(name)) {
        name
    }
    else if (!is.null(filename_header)) {
        filename_header
    }
    else {
        if (use_counter) {
            include_dash <- FALSE
            ".download"
        }
        else {
            fs::path_file(tempfile(fileext = ".download"))
        }
    }
    if (use_counter) {
        dash <- if (include_dash) 
            "-"
        else ""
        filename <- sprintf("%03d%s%s", private$counter$increment(), 
            dash, filename)
    }
    download_path <- fs::path(save_dir, fs::path_sanitize(filename, 
        "_"))
    writeBin(httr2::resp_body_raw(req), download_path)
    list(download_path = download_path, filename_header = filename_header)
}
