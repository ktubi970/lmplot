FUNCTION chromote_eval 
function (chromote_session, js, ..., timeout = 4 * 1000, timeout_ = missing_arg(), 
    awaitPromise = TRUE, returnByValue = TRUE, allow_no_response = FALSE) 
{
    assert_chromote_session(chromote_session)
    js <- as.character(js)
    checkmate::assert_character(js, any.missing = FALSE, len = 1)
    if (isTRUE(allow_no_response)) {
        checkmate::assert_false(awaitPromise)
        checkmate::assert_false(returnByValue)
    }
    else {
        checkmate::assert_true(awaitPromise)
        checkmate::assert_true(returnByValue)
    }
    js <- paste0("{\n", js, "\n}")
    result <- tryCatch({
        chromote_session$Runtime$evaluate(js, ..., timeout = timeout, 
            timeout_ = timeout_, awaitPromise = awaitPromise, 
            returnByValue = returnByValue, wait_ = TRUE)
    }, error = function(e) {
        list(results = list(type = "object", subtype = "error", 
            className = "Error", description = paste0("Error found while trying to evaluate script: ", 
                as.character(e))))
    })
    result
}
