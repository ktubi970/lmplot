FUNCTION with_external_shiny_browser 
function (code) 
{
    is_rstudio_server <- rstudio_is_available() && rstudioapi::versionInfo()$mode == 
        "server"
    is_rstudio_desktop <- rstudio_is_available() && rstudioapi::versionInfo()$mode != 
        "server"
    if (!is_rstudio_server) {
        browser <- chromote::default_chromote_object()$get_browser()
        if (inherits(browser, "Chrome")) {
            browser_path <- browser$get_path()
            if (!is_windows()) 
                browser_path <- shQuote(browser_path)
            open_chrome <- function(url) {
                utils::browseURL(url, browser_path)
            }
            old_options <- options(shiny.launch.browser = open_chrome)
            withr::defer({
                options(old_options)
            })
        }
        else if (is_rstudio_desktop) {
            if (rstudioapi::isAvailable("1.3.387")) {
                shiny_viewer_type <- rstudioapi::readRStudioPreference("shiny_viewer_type", 
                  "window")
                withr::defer({
                  rstudioapi::writeRStudioPreference("shiny_viewer_type", 
                    shiny_viewer_type)
                })
                rstudioapi::writeRStudioPreference("shiny_viewer_type", 
                  "browser")
            }
            else {
                open_external <- get(".rs.invokeShinyWindowExternal", 
                  envir = as.environment("tools:rstudio"))
                old_option <- options(shiny.launch.browser = open_external)
                withr::defer({
                  options(old_option)
                })
            }
        }
    }
    force(code)
}
